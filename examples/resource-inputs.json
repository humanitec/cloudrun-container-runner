{
  "_comment": "Sample RESOURCE_INPUTS_FILE, i.e. what the Container Driver writes for the Runner and names in $RESOURCE_INPUTS_FILE. Mirrors ResourceInputs in cmd/score2cloudrun/main.go: id, spec, substitutions, extensions. Keys the Runner does not recognise are ignored. The deployment target is deliberately absent: score2cloudrun reads it from CLOUDSDK_CORE_PROJECT and CLOUDSDK_RUN_REGION, set through job.variables in the Resource Definition.",

  "id": "hello-world-dev",

  "spec": {
    "apiVersion": "score.dev/v1b1",
    "metadata": {
      "name": "hello-world"
    },
    "containers": {
      "main": {
        "image": "us-docker.pkg.dev/cloudrun/container/hello",
        "variables": {
          "GREETING": "hello from Score",
          "DB_URL": "${resources.db.uri}"
        },
        "volumes": {
          "/app/backend/data": {
            "source": "${resources.data}"
          }
        },
        "resources": {
          "limits": {
            "cpu": "1",
            "memory": "512Mi"
          }
        }
      }
    },
    "service": {
      "ports": {
        "http": {
          "port": 8080,
          "targetPort": 8080
        }
      }
    },
    "resources": {
      "db": {
        "type": "postgres"
      },
      "data": {
        "type": "volume"
      }
    }
  },

  "substitutions": {
    "resources.db.uri": {
      "secret": true,
      "value": "postgres://user:password@10.0.0.1:5432/hello-world"
    },
    "resources.data": {
      "secret": false,
      "value": {
        "google-cloud-run": {
          "csi": {
            "driver": "gcsfuse.run.googleapis.com",
            "volumeAttributes": {
              "bucketName": "my-bucket-name"
            }
          }
        }
      }
    }
  },

  "extensions": {
    "cloudrun": {
      "scaling": {
        "min_instances": 0,
        "max_instances": 10
      },
      "allow_unauthenticated": true,
      "service_account": "cloudrun-deployer@my-gcp-project.iam.gserviceaccount.com"
    }
  }
}
